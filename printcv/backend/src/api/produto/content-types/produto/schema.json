{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto",
    "description": "Produtos de impressão 3D"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "descricao": {
      "type": "richtext"
    },
    "preco": {
      "type": "decimal",
      "default": 0
    },
    "preco_sob_consulta": {
      "type": "boolean",
      "default": false
    },
    "imagens": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "produtos"
    },
    "destaque": {
      "type": "boolean",
      "default": false
    },
    "disponivel": {
      "type": "boolean",
      "default": true
    },
    "tempo_producao": {
      "type": "string"
    },
    "material": {
      "type": "enumeration",
      "enum": [
        "PLA",
        "PETG",
        "TPU",
        "Misto"
      ]
    },
    "dimensoes": {
      "type": "string"
    },
    "Em_stock": {
      "type": "boolean"
    },
    "Cor_disponivel": {
      "type": "string"
    }
  }
}
